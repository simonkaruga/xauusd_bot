# Dashboard auth token — required to use Pause / Kill Switch buttons
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_TOKEN=change_me
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# MetaTrader 5 Credentials
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=HFM-Demo

# Telegram Notifications (optional — set TELEGRAM_ENABLED=True to activate)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Signal Broadcasting (optional — public channel + copy-trading webhook)
SIGNAL_CHANNEL_ID=@YourSignalChannel
SIGNAL_WEBHOOK_URL=
